<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="HomePage.master.cs" Inherits="BBMS.HomePage" %>

<!DOCTYPE html>

<html>
<head runat="server">
     <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
   <title>  <asp:ContentPlaceHolder ID="TitleContent" runat="server">
    </asp:ContentPlaceHolder></title>
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
      <style type="text/css">
        * { box-sizing: border-box; margin:0; padding:0; }
        body { font-family:'Inter', 'Segoe UI', sans-serif; background:#fff; color:#1b2333; }

        /* ===== NAVBAR ===== */
        .navbar { border-bottom:1px solid #eef0f4; position:sticky; top:0; z-index:50; background:#fff; }
        .navbar-inner { max-width:1300px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; padding:16px 32px; }

        .nav-brand { display:flex; align-items:center; gap:10px; text-decoration:none; }
        .nav-brand .drop { width:40px; height:40px; border-radius:10px; background:#e11d2e; display:flex; align-items:center; justify-content:center; font-size:19px; color:#fff; }
        .nav-brand .brand-text { line-height:1.1; }
        .nav-brand .brand-text .b1 { font-family:'Poppins',sans-serif; font-weight:800; font-size:19px; color:#1b2333; }
        .nav-brand .brand-text .b1 span { color:#e11d2e; }
        .nav-brand .brand-text small { display:block; font-size:11px; color:#9aa1b0; letter-spacing:.2px; }

           .nav-links { display:flex; align-items:center; gap:30px; }
        .nav-links a { color:#4b5563; text-decoration:none; font-size:14.5px; font-weight:500; padding-bottom:22px; margin-bottom:-22px; border-bottom:2px solid transparent; transition:.2s; }
        .nav-links a:hover { color:#e11d2e; }
        .nav-links a.active-link { color:#e11d2e; border-bottom-color:#e11d2e; font-weight:600; }

        .nav-actions { display:flex; align-items:center; gap:12px; }
        .btn-login { display:flex; align-items:center; gap:7px; border:1px solid #e5e7eb; padding:9px 20px; border-radius:8px; color:#1b2333; text-decoration:none; font-weight:600; font-size:14px; transition:.2s; }
        .btn-login:hover { background:#f9fafb; }
        .btn-register { background:#e11d2e; color:#fff; padding:9px 22px; border-radius:8px; text-decoration:none; font-weight:600; font-size:14px; transition:.2s; }
        .btn-register:hover { background:#c8172a; }

          .hero { background:linear-gradient(180deg, #fafbfc 0%, #f3f5fa 100%); padding:60px 32px 0; }
        .hero-inner { max-width:1300px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; }

        .hero-text h1 { font-family:'Poppins',sans-serif; font-size:48px; font-weight:800; line-height:1.15; color:#1b2333; opacity:0; transform:translateY(18px); animation:heroUp .6s ease forwards; }
        .hero-text h1 span { color:#e11d2e; }
        .hero-text p { color:#6b7280; font-size:16px; margin-top:18px; line-height:1.6; opacity:0; transform:translateY(18px); animation:heroUp .6s ease .1s forwards; }
        @keyframes heroUp { to { opacity:1; transform:translateY(0); } }

        .hero-buttons { display:flex; gap:14px; margin-top:28px; opacity:0; transform:translateY(18px); animation:heroUp .6s ease .2s forwards; }
        .btn-hero-red { background:#e11d2e; color:#fff; padding:13px 26px; border-radius:8px; text-decoration:none; font-weight:600; font-size:14.5px; display:flex; align-items:center; gap:8px; transition:.2s; }
        .btn-hero-red:hover { background:#c8172a; transform:translateY(-2px); }
        .btn-hero-outline { border:1.5px solid #e5e7eb; color:#1b2333; padding:13px 26px; border-radius:8px; text-decoration:none; font-weight:600; font-size:14.5px; display:flex; align-items:center; gap:8px; transition:.2s; }
        .btn-hero-outline:hover { border-color:#e11d2e; color:#e11d2e; }

          .hero-image { border-radius:20px; overflow:hidden; opacity:0; animation:fadeIn .8s ease .15s forwards; }
        .hero-image img { width:100%; height:340px; object-fit:cover; display:block; }
        @keyframes fadeIn { to { opacity:1; } }

        .hero-stats { max-width:1300px; margin:44px auto 0; display:grid; grid-template-columns:repeat(4, 1fr); gap:20px; padding-bottom:50px; }
        .stat-box { background:#fff; border-radius:14px; padding:20px; display:flex; align-items:center; gap:14px; box-shadow:0 3px 14px rgba(0,0,0,.05); opacity:0; transform:translateY(15px); animation:fadeUp .5s ease forwards; }
        .hero-stats .stat-box:nth-child(1){animation-delay:.25s}
        .hero-stats .stat-box:nth-child(2){animation-delay:.35s}
        .hero-stats .stat-box:nth-child(3){animation-delay:.45s}
        .hero-stats .stat-box:nth-child(4){animation-delay:.55s}
        @keyframes fadeUp { to { opacity:1; transform:translateY(0); } }
        .stat-icon { width:44px; height:44px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:19px; flex-shrink:0; }
        .stat-box h4 { font-family:'Poppins',sans-serif; font-size:21px; font-weight:800; color:#1b2333; }
        .stat-box span { font-size:12.5px; color:#6b7280; }

           .info-section { background:#fff; padding:70px 32px; }
        .info-grid { max-width:1300px; margin:0 auto; display:grid; grid-template-columns:1.3fr 1fr 0.7fr; gap:50px; }
        .info-col h2 { font-family:'Poppins',sans-serif; font-size:26px; font-weight:800; color:#1b2333; margin-bottom:12px; }
        .info-col > p { color:#6b7280; font-size:14.5px; line-height:1.6; margin-bottom:26px; }

        .reason-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; }
        .reason-item { display:flex; gap:14px; }
        .reason-icon { width:42px; height:42px; border-radius:10px; background:#fde8e8; color:#e11d2e; display:flex; align-items:center; justify-content:center; font-size:17px; flex-shrink:0; }
        .reason-item strong { display:block; font-size:14.5px; color:#1b2333; margin-bottom:3px; }
        .reason-item p { font-size:13px; color:#6b7280; line-height:1.45; }

        .info-divider { border-left:1px solid #eef0f4; padding-left:40px; }
        .check-list { list-style:none; display:flex; flex-direction:column; gap:16px; }
        .check-list li { font-size:14.5px; color:#374151; display:flex; align-items:center; gap:10px; }
        .check-list li i { color:#e11d2e; font-size:16px; }

          .info-illustration { display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; }
        .blood-bag { width:110px; height:150px; background:#fff; border:2px solid #f3f5fa; border-radius:14px; box-shadow:0 10px 26px rgba(0,0,0,.08); position:relative; z-index:2; }
        .bag-top { width:36px; height:14px; background:#e5e7eb; border-radius:6px 6px 0 0; margin:0 auto; }
        .bag-body { background:#e11d2e; height:120px; border-radius:0 0 12px 12px; margin-top:0; padding:12px; }
        .bag-label { background:#fff; color:#1b2333; font-weight:800; font-family:'Poppins',sans-serif; font-size:20px; text-align:center; border-radius:6px; padding:8px 0; }
        .bag-lines { margin-top:10px; height:2px; background:rgba(255,255,255,.4); }
        .heart-outline { position:absolute; right:0; bottom:10px; font-size:90px; color:#f3d0d3; z-index:1; }

        /* ===== EMERGENCY BAR ===== */
        .emergency-bar { background:linear-gradient(90deg, #7a1420, #a31d2b); padding:26px 32px; }
        .emergency-inner { max-width:1300px; margin:0 auto; display:flex; align-items:center; gap:34px; color:#fff; }
        .emergency-item { display:flex; align-items:center; gap:14px; }
        .emergency-icon { width:44px; height:44px; border-radius:50%; background:#fff; color:#a31d2b; display:flex; align-items:center; justify-content:center; font-size:17px; flex-shrink:0; }
        .emergency-item strong { display:block; font-size:15px; }
        .emergency-item p { font-size:12.5px; opacity:.85; margin-top:2px; }
        .emergency-divider { width:1px; height:36px; background:rgba(255,255,255,.25); }
        .btn-emergency { margin-left:auto; background:#fff; color:#a31d2b; padding:11px 24px; border-radius:8px; text-decoration:none; font-weight:700; font-size:14px; display:flex; align-items:center; gap:8px; transition:.2s; }
        .btn-emergency:hover { transform:translateY(-2px); }

          .page-header { background:linear-gradient(135deg, #1b2333, #2a3550); padding:70px 32px; text-align:center; }
        .page-header-inner { max-width:640px; margin:0 auto; }
        .eyebrow-light { display:inline-block; font-size:12px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#ff5b6a; margin-bottom:10px; }
        .eyebrow { display:inline-block; font-size:12px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase; color:#e11d2e; margin-bottom:10px; }
        .page-header h1 { font-family:'Poppins',sans-serif; font-size:34px; font-weight:800; color:#fff; }
        .page-header p { color:#b6bccb; font-size:15px; margin-top:14px; line-height:1.6; }

        .about-section { padding:70px 32px; background:#fff; }
        .about-grid { max-width:1200px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:50px; align-items:center; }
        .about-image img { width:100%; height:380px; object-fit:cover; border-radius:18px; box-shadow:0 10px 30px rgba(0,0,0,.08); }
        .about-text h2 { font-family:'Poppins',sans-serif; font-size:28px; font-weight:800; color:#1b2333; margin:8px 0 16px; line-height:1.25; }
        .about-text > p { color:#6b7280; font-size:14.5px; line-height:1.7; margin-bottom:20px; }
        .about-points { display:flex; flex-direction:column; gap:12px; }
        .about-point { display:flex; align-items:center; gap:10px; font-size:14px; color:#374151; font-weight:500; }
        .about-point i { color:#e11d2e; font-size:16px; }

           .about-stats-strip { background:#f3f5fa; padding:36px 32px; }
        .about-stats-inner { max-width:1000px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); text-align:center; }
        .about-stats-inner h3 { font-family:'Poppins',sans-serif; font-size:26px; font-weight:800; color:#e11d2e; }
        .about-stats-inner span { font-size:12.5px; color:#6b7280; }

        .values-section { padding:70px 32px; background:#fff; }
        .role-heading { max-width:1180px; margin:0 auto 34px; text-align:center; }
        .role-heading h2 { font-family:'Poppins',sans-serif; font-size:28px; font-weight:800; color:#1b2333; }

        .values-grid { max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(4, 1fr); gap:20px; }
        .value-card, .service-card { background:#fff; border:1px solid #eef0f4; border-radius:16px; padding:26px 20px; text-align:left; text-decoration:none; color:#1b2333; box-shadow:0 3px 12px rgba(0,0,0,.04); transition:transform .25s ease, box-shadow .25s ease; }
        .value-card:hover, .service-card:hover { transform:translateY(-6px); box-shadow:0 14px 26px rgba(0,0,0,.1); }
        .value-icon { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:19px; margin-bottom:16px; }
        .value-card h3, .service-card h3 { font-family:'Poppins',sans-serif; font-size:16px; font-weight:700; margin-bottom:8px; }
        .value-card p, .service-card p { font-size:13.5px; color:#6b7280; line-height:1.55; }

           @media (max-width: 992px) {
            .nav-links { display:none; }
            .hero-inner { grid-template-columns:1fr; }
            .hero-image { order:-1; }
            .hero-stats { grid-template-columns:repeat(2,1fr); }
            .info-grid { grid-template-columns:1fr; }
            .info-divider { border-left:none; padding-left:0; border-top:1px solid #eef0f4; padding-top:30px; }
            .emergency-inner { flex-wrap:wrap; gap:16px; }
            .btn-emergency { margin-left:0; }
            .about-grid { grid-template-columns:1fr; }
            .about-stats-inner { grid-template-columns:repeat(2,1fr); gap:20px; }
            .values-grid { grid-template-columns:repeat(2,1fr); }
        }
        @media (max-width: 560px) {
            .values-grid { grid-template-columns:1fr; }
        }
          </style>
</head>
<body>
     <div class="navbar">
            <div class="navbar-inner">
                <a href="Default.aspx" class="nav-brand">
                    <div class="drop"><i class="bi bi-droplet-fill"></i></div>
                    <div class="brand-text">
                        <div class="b1">BLOOD <span>BANK</span></div>
                        <small>Save Life, Donate Blood</small>
                    </div>
                </a>


                <div class="nav-links">
            <div class="nav-links">
    <asp:HyperLink ID="navHome" runat="server" NavigateUrl="~/Default.aspx">Home</asp:HyperLink>
    <asp:HyperLink ID="navAbout" runat="server" NavigateUrl="~/AboutUs.aspx">About Us</asp:HyperLink>
    <asp:HyperLink ID="navServices" runat="server" NavigateUrl="~/Services.aspx">Services</asp:HyperLink>
</div>
                </div>

                <div class="nav-actions">
                    <a href="Login.aspx" class="btn-login"><i class="bi bi-person"></i> Login</a>
                    <a href="Register.aspx" class="btn-register">Register</a>
                </div>
            </div>
        </div>
    <form id="form1" runat="server">
        <div>
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
